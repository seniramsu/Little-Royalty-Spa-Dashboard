# Supabase project credentials
# Copy this file to .env.local and fill in your values
# Get these from: https://supabase.com/dashboard -> Settings -> API

NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# NEVER use NEXT_PUBLIC_ prefix for service role key — it would expose it to the browser
# Only used in server-side scripts (e.g. scripts/seed-auth.ts)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Site URL — used for password reset redirect
# Dev: http://localhost:3000
# Production: update in Vercel environment variables to your deployed URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000
